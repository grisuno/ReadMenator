{"uid":"readmenator/_docbranch.py","name":"_docbranch.py","qualname":"readmenator/_docbranch.py","kind":"module","file":"readmenator/_docbranch.py","line":1,"end_line":316,"language":"py","signature":"","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Documentation branch publisher: artifacts live in their own git branch.","description":"Generated artifacts (maps, site, video, agent docs, wiki) change the\nlanguage GitHub reports for a project -- a C repository can show up as\n\"HTML\" once the generated pages are committed. Two fixes ship here:\n\n1. ``ensure_gitattributes`` marks every generated output directory as\n   ``linguist-generated`` so language statistics always describe the\n   source tree, no matter where artifacts live.\n2. ``publish`` stages the static site (``readmenator . pages`` output)\n   into an orphan git branch (``DOC_BRANCH_NAME``) and pushes it, so\n   GitHub Pages can deploy \"from branch\" and the main branch stays free\n   of generated artifacts entirely.\n\nThe Pages URL is inferred from the origin remote (``github.com/user/repo``\n-> ``https://user.github.io/repo/``), overridable via ``DOC_PAGES_URL``,\nand is what the README injection links so following a link from the\nREADME lands on the deployed documentation instead of a dead repo path.\nGit is driven with argument lists only (no shell), bounded timeouts, and\nan injectable runner for tests.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"","members":["readmenator/_docbranch.py::DocsBranchResult","readmenator/_docbranch.py::DocsBranchPublisher"],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
