{"uid":"readmenator/_graphlayout.py","name":"_graphlayout.py","qualname":"readmenator/_graphlayout.py","kind":"module","file":"readmenator/_graphlayout.py","line":1,"end_line":860,"language":"py","signature":"","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Deterministic graph layout algorithms for animated renders.","description":"Implements two layout families used by the cinematic video:\n\n- ForceAtlas2 (Jacomy et al., 2014): degree-weighted repulsion,\n  LinLog attraction, degree-weighted gravity, and the adaptive global\n  speed driven by swing and traction. Snapshots are recorded during\n  the run so the convergence itself can be animated.\n- Hierarchical edge bundling (Holten, 2006): leaves placed on a circle\n  grouped by community, every edge routed through the community\n  hierarchy as a control polygon, straightened by the bundling\n  strength beta, and sampled as a uniform cubic B-spline.\n- Spherical edge bundling: the same hierarchy on a unit sphere, each\n  community owning a cap of Fibonacci lattice points sized by its\n  member count, hubs inside the sphere and the root at its center.\n- Crossing reduction for both: group order by weighted adjacency with\n  2-opt, center-out hub seeding, barycentric member sweeps on the\n  circle, and neighbour-facing point assignment inside sphere caps.\n\nForceAtlas2 runs in two or three dimensions (settings.dims).\n\nnumpy is used when available for the O(n^2) force pass; a pure Python\npath keeps the module dependency-free (the iteration budget shrinks\nto keep the fallback fast). Results are deterministic for a given\nseed and input ordering.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"","members":["readmenator/_graphlayout.py::ForceAtlas2Settings","readmenator/_graphlayout.py::forceatlas2_frames","readmenator/_graphlayout.py::fit_frames","readmenator/_graphlayout.py::interpolate_frames","readmenator/_graphlayout.py::BundleLayout","readmenator/_graphlayout.py::hierarchical_edge_bundling","readmenator/_graphlayout.py::fibonacci_sphere","readmenator/_graphlayout.py::SphereBundleLayout","readmenator/_graphlayout.py::spherical_edge_bundling","readmenator/_graphlayout.py::normalize_cloud","readmenator/_graphlayout.py::bundle_angular_cost","readmenator/_graphlayout.py::optimize_bundle_order","readmenator/_graphlayout.py::refine_sphere_leaves"],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
