{"uid":"readmenator/_graphlayout.py::spherical_edge_bundling","name":"spherical_edge_bundling","qualname":"spherical_edge_bundling","kind":"function","file":"readmenator/_graphlayout.py","line":516,"end_line":583,"language":"py","signature":"def spherical_edge_bundling(groups: Dict[str, List[str]], edges: Sequence[Tuple[str, str]], radius: float = 1.0, beta: float = 0.85, samples: int = 24, inner_ratio: float = 0.55, refine_sweeps: int = 0, affinity_edges: Optional[Sequence[Tuple[str, str]]] = None) -> SphereBundleLayout","params":[{"name":"groups","annotation":"Dict[str, List[str]]","default":"","kind":"positional"},{"name":"edges","annotation":"Sequence[Tuple[str, str]]","default":"","kind":"positional"},{"name":"radius","annotation":"float","default":"1.0","kind":"positional"},{"name":"beta","annotation":"float","default":"0.85","kind":"positional"},{"name":"samples","annotation":"int","default":"24","kind":"positional"},{"name":"inner_ratio","annotation":"float","default":"0.55","kind":"positional"},{"name":"refine_sweeps","annotation":"int","default":"0","kind":"positional"},{"name":"affinity_edges","annotation":"Optional[Sequence[Tuple[str, str]]]","default":"None","kind":"positional"}],"returns":"SphereBundleLayout","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Lay leaves on a sphere in community caps and bundle edges through the hierarchy.","description":"Leaves occupy a Fibonacci lattice with one point per member. The\nlattice is split recursively: the groups are cut into two runs of\nnearly equal total size, the points are sorted along their axis of\nlargest spread and cut at the same count, and each half recurses.\nEvery community therefore owns one contiguous cap whose area matches\nits size exactly. Inside a cap the points nearest its mean direction\ngo to the members listed first (callers list hubs first). Each hub\nsits at the cap's mean direction scaled by inner_ratio; the root is\nthe sphere center.","params":[{"name":"groups","type":"","description":"Ordered mapping of group label to member ids.","default":""},{"name":"edges","type":"","description":"(source, target) pairs between members.","default":""},{"name":"radius","type":"","description":"Sphere radius.","default":""},{"name":"beta","type":"","description":"Bundling strength in [0, 1].","default":""},{"name":"samples","type":"","description":"Points per sampled curve.","default":""},{"name":"inner_ratio","type":"","description":"Radius ratio of the group hubs.","default":""},{"name":"refine_sweeps","type":"","description":"When > 0, members are reassigned inside their cap\nto face their neighbours (refine_sphere_leaves) before curves\nare sampled.","default":""},{"name":"affinity_edges","type":"","description":"Edges used for refinement (defaults to *edges*).","default":""}],"returns":{"name":"","type":"","description":"SphereBundleLayout with leaf positions, caps, hubs, and curves.","default":""},"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"google"},"parent":"readmenator/_graphlayout.py","members":[],"inferred_raises":[],"returns_value":true,"value":"","base_uids":[],"subclasses":[],"calls":["readmenator/_graphlayout.py::SphereBundleLayout","readmenator/_graphlayout.py::fibonacci_sphere","readmenator/_graphlayout.py::refine_sphere_leaves"],"called_by":["readmenator/_bundlegraph.py::BundleGraphRenderer.build_payload","readmenator/_video.py::CinematicVideoRenderer.sphere_layout"]}
{"uid":"readmenator/_graphlayout.py::normalize_cloud","name":"normalize_cloud","qualname":"normalize_cloud","kind":"function","file":"readmenator/_graphlayout.py","line":586,"end_line":620,"language":"py","signature":"def normalize_cloud(points: Dict[str, Tuple[float, ...]], quantile: float = 0.85, max_radius: float = 1.3) -> Dict[str, Point3]","params":[{"name":"points","annotation":"Dict[str, Tuple[float, ...]]","default":"","kind":"positional"},{"name":"quantile","annotation":"float","default":"0.85","kind":"positional"},{"name":"max_radius","annotation":"float","default":"1.3","kind":"positional"}],"returns":"Dict[str, Point3]","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Center a 3D point cloud, scale a radius quantile to 1, and pull outliers in.","description":"Force layouts push isolated files far from the core; scaling by the\nfull extent would shrink the core to a dot. Points beyond radius 1\nare compressed smoothly (tanh) so none lies past max_radius.","params":[{"name":"points","type":"","description":"Raw 3D positions.","default":""},{"name":"quantile","type":"","description":"Fraction of points that end up inside the unit sphere.","default":""},{"name":"max_radius","type":"","description":"Hard bound on the radius after compression (> 1).","default":""}],"returns":{"name":"","type":"","description":"Normalized positions (empty for no points).","default":""},"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"google"},"parent":"readmenator/_graphlayout.py","members":[],"inferred_raises":[],"returns_value":true,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":["readmenator/_video.py::CinematicVideoRenderer.orbit_positions"]}
{"uid":"readmenator/_graphlayout.py::bundle_angular_cost","name":"bundle_angular_cost","qualname":"bundle_angular_cost","kind":"function","file":"readmenator/_graphlayout.py","line":654,"end_line":673,"language":"py","signature":"def bundle_angular_cost(groups: Dict[str, List[str]], edges: Sequence[Tuple[str, str]], group_gap: float = 0.04) -> float","params":[{"name":"groups","annotation":"Dict[str, List[str]]","default":"","kind":"positional"},{"name":"edges","annotation":"Sequence[Tuple[str, str]]","default":"","kind":"positional"},{"name":"group_gap","annotation":"float","default":"0.04","kind":"positional"}],"returns":"float","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Total angular length of all edges for a circular group layout.","description":"Shorter total angular length means shorter bundles and fewer\ncrossings in hierarchical edge bundling.","params":[{"name":"groups","type":"","description":"Ordered group label to ordered member ids.","default":""},{"name":"edges","type":"","description":"(source, target) pairs.","default":""},{"name":"group_gap","type":"","description":"Angular gap between groups in radians.","default":""}],"returns":{"name":"","type":"","description":"Sum over edges of the angular distance between their endpoints.","default":""},"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"google"},"parent":"readmenator/_graphlayout.py","members":[],"inferred_raises":[],"returns_value":true,"value":"","base_uids":[],"subclasses":[],"calls":["readmenator/_graphlayout.py::hierarchical_edge_bundling"],"called_by":["readmenator/_graphlayout.py::optimize_bundle_order"]}
{"uid":"readmenator/_graphlayout.py::optimize_bundle_order","name":"optimize_bundle_order","qualname":"optimize_bundle_order","kind":"function","file":"readmenator/_graphlayout.py","line":702,"end_line":801,"language":"py","signature":"def optimize_bundle_order(groups: Dict[str, List[str]], edges: Sequence[Tuple[str, str]], sweeps: int = 6, passes: int = 8, group_gap: float = 0.04) -> Dict[str, List[str]]","params":[{"name":"groups","annotation":"Dict[str, List[str]]","default":"","kind":"positional"},{"name":"edges","annotation":"Sequence[Tuple[str, str]]","default":"","kind":"positional"},{"name":"sweeps","annotation":"int","default":"6","kind":"positional"},{"name":"passes","annotation":"int","default":"8","kind":"positional"},{"name":"group_gap","annotation":"float","default":"0.04","kind":"positional"}],"returns":"Dict[str, List[str]]","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Reorder groups and members to shorten bundled edges (fewer crossings).","description":"Three deterministic stages, each accepted only when it lowers the\ntotal angular edge length (bundle_angular_cost):\n\n1. Group order: the first group stays first; the rest are chained\n   greedily by inter-group edge weight, then refined with 2-opt\n   reversals on the weighted arc-center distance.\n2. Center-out seeding: inside each group the first-listed members\n   (hubs, by caller rank) move to the middle of their arc.\n3. Barycentric sweeps: each member is placed at the circular mean\n   of its neighbours' angles projected onto its own arc, the\n   classic crossing-reduction heuristic (Sugiyama-style) applied\n   to the radial layout; members without neighbours keep their slot.","params":[{"name":"groups","type":"","description":"Ordered group label to ranked member ids.","default":""},{"name":"edges","type":"","description":"(source, target) pairs between members.","default":""},{"name":"sweeps","type":"","description":"Barycentric refinement sweeps.","default":""},{"name":"passes","type":"","description":"2-opt passes over the group order.","default":""},{"name":"group_gap","type":"","description":"Angular gap between groups in radians.","default":""}],"returns":{"name":"","type":"","description":"A new ordered mapping with the same groups and members.","default":""},"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"google"},"parent":"readmenator/_graphlayout.py","members":[],"inferred_raises":[],"returns_value":true,"value":"","base_uids":[],"subclasses":[],"calls":["readmenator/_graphlayout.py::bundle_angular_cost","readmenator/_graphlayout.py::hierarchical_edge_bundling"],"called_by":["readmenator/_bundlegraph.py::BundleGraphRenderer.build_payload","readmenator/_video.py::CinematicVideoRenderer.ordered_groups"]}
{"uid":"readmenator/_graphlayout.py::refine_sphere_leaves","name":"refine_sphere_leaves","qualname":"refine_sphere_leaves","kind":"function","file":"readmenator/_graphlayout.py","line":804,"end_line":860,"language":"py","signature":"def refine_sphere_leaves(layout: SphereBundleLayout, groups: Dict[str, List[str]], edges: Sequence[Tuple[str, str]], sweeps: int = 4) -> SphereBundleLayout","params":[{"name":"layout","annotation":"SphereBundleLayout","default":"","kind":"positional"},{"name":"groups","annotation":"Dict[str, List[str]]","default":"","kind":"positional"},{"name":"edges","annotation":"Sequence[Tuple[str, str]]","default":"","kind":"positional"},{"name":"sweeps","annotation":"int","default":"4","kind":"positional"}],"returns":"SphereBundleLayout","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Reassign leaves inside each cap so members face their neighbours.","description":"Every cap keeps exactly its lattice points; members are visited by\ndescending degree and take the free point closest to the mean\ndirection of their neighbours (cap center for isolated members).\nA sweep is kept only when the total chord length of all edges drops.","params":[{"name":"layout","type":"","description":"Result of spherical_edge_bundling.","default":""},{"name":"groups","type":"","description":"Group label to member ids (same as the layout input).","default":""},{"name":"edges","type":"","description":"(source, target) pairs.","default":""},{"name":"sweeps","type":"","description":"Maximum refinement sweeps.","default":""}],"returns":{"name":"","type":"","description":"A new SphereBundleLayout with reassigned leaves (curves unchanged).","default":""},"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"google"},"parent":"readmenator/_graphlayout.py","members":[],"inferred_raises":[],"returns_value":true,"value":"","base_uids":[],"subclasses":[],"calls":["readmenator/_graphlayout.py::SphereBundleLayout"],"called_by":["readmenator/_graphlayout.py::spherical_edge_bundling"]}
